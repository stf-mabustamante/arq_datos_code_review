{
  "summary": {
    "version": "compact-1",
    "purpose": "Mapa compacto para leer archivos .ini TLS en validaciones AutoEdd.",
    "scope": [
      "Seleccion de ini UNI con TASK dbt_run y extraccion de CLOUD_RUN_NAME",
      "Lectura de campos top_level y MESSAGE JSON",
      "Soporte a consultas humanas frecuentes usadas por el agente"
    ],
    "source_catalog": "tls_parametros_task_data_catalog.csv"
  },
  "agent_instructions": [
    "Ignorar lineas comentadas que comiencen con # o ;.",
    "Para campos top_level buscar el patron exacto CAMPO=.",
    "Para campos en scope message buscar MESSAGE= y parsear el JSON antes de extraer la clave.",
    "Si la consulta es humana, resolver primero con lookup_index y luego restringir por task_profile.",
    "No inferir campos fuera de este mapping compacto."
  ],
  "resolution_order": [
    "Identificar TASK",
    "Resolver task_profile",
    "Leer campos top_level requeridos",
    "Si aplica, parsear MESSAGE",
    "Buscar el campo exacto o por concepto"
  ],
  "task_profiles": {
    "fw_ingesta_tasks.dbt/run:dbt_run": {
