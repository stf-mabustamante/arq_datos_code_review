        "PCM_EXTRA_VARS",
        "MESSAGE"
      ],
      "message_fields": [
        "appname",
        "runid",
        "dbt_project",
        "target",
        "variables"
      ]
    },
    "fw_ingesta_tasks.dbt/run:dbt_run_select": {
